@page "/spreadsheet/freezepane"

@using Syncfusion.Blazor.Spreadsheet
@using System;
@using System.IO;

@*Hidden:Lines*@
@inherits SampleBaseComponent;
@inject NavigationManager NavigationManager
@*End:Hidden*@


<ActionDescription>
    <p>This sample demonstrates the freeze pane capabilities of Blazor Spreadsheet using a Gross Salary worksheet. It highlights how you can freeze rows and columns within a worksheet to keep important information visible while navigating large datasets.</p>

    <p>The Blazor Spreadsheet freeze pane feature enables you to lock rows and columns within a worksheet. You can configure frozen panes using the <a href="https://help.syncfusion.com/cr/blazor/Syncfusion.Blazor.Spreadsheet.Sheet.html#Syncfusion_Blazor_Spreadsheet_Sheet_FrozenRows" target="_blank" rel="noopener noreferrer" aria-label="Navigate to the FrozenRows property documentation">FrozenRows</a> and <a href="https://help.syncfusion.com/cr/blazor/Syncfusion.Blazor.Spreadsheet.Sheet.html#Syncfusion_Blazor_Spreadsheet_Sheet_FrozenColumns" target="_blank" rel="noopener noreferrer" aria-label="Navigate to the FrozenColumns property documentation">FrozenColumns</a> properties to specify the number of rows and columns to freeze.</p>

    <p><strong>Working with Freeze Panes::</strong></p>
    <ul>
        <li>Freeze rows to keep header information visible while scrolling vertically.</li>
        <li>Freeze columns to retain important data while scrolling horizontally.</li>
        <li>Freeze both rows and columns simultaneously to improve worksheet navigation.</li>
        <li>Maintain visibility of key worksheet content when working with large datasets.</li>
        <li>Improve readability and data analysis by keeping critical information always in view.</li>
        <li>Import and export Excel files containing frozen rows and columns while preserving freeze pane settings.</li>
    </ul>

    <p>You can freeze rows and columns programmatically using the <a href="https://help.syncfusion.com/cr/blazor/Syncfusion.Blazor.Spreadsheet.SfSpreadsheet.html#Syncfusion_Blazor_Spreadsheet_SfSpreadsheet_FreezePanesAsync_System_Int32_System_Int32_" target="_blank" rel="noopener noreferrer" aria-label="Navigate to the Blazor Spreadsheet FreezePanesAsync documentation">FreezePanesAsync</a> method. To remove existing frozen panes, use the <a href="https://help.syncfusion.com/cr/blazor/Syncfusion.Blazor.Spreadsheet.SfSpreadsheet.html#Syncfusion_Blazor_Spreadsheet_SfSpreadsheet_UnfreezePanesAsync" target="_blank" rel="noopener noreferrer" aria-label="Navigate to the Blazor Spreadsheet UnfreezePanesAsync documentation">UnfreezePanesAsync</a> method, which restores the default worksheet scrolling behavior.</p>
    <p>For more detailed information about freeze panes, refer to the <a href="https://help.syncfusion.com/document-processing/excel/spreadsheet/blazor/freeze-pane" target="_blank" rel="noopener noreferrer" aria-label="Navigate to the Blazor Spreadsheet Freeze Panes documentation">freeze panes documentation</a>.</p>
    <p>Looking for the full Blazor Spreadsheet Editor component overview, features, pricing, and documentation? Visit the <a rel="noopener" target="_blank" href="https://www.syncfusion.com/spreadsheet-editor-sdk/blazor-spreadsheet-editor" aria-label="Navigate to the Blazor Spreadsheet Editor FT page">Blazor Spreadsheet Editor component</a> page.</p>
</ActionDescription>

<div class="col-lg-12 control-section">
    <div class="content-wrapper">
        <div class="row">
            <div>
                <SfSpreadsheet DataSource="DataSourceBytes" @ref=_spreadsheetInstance>
                    <SpreadsheetRibbon></SpreadsheetRibbon>
                </SfSpreadsheet>
            </div>

        </div>
    </div>
</div>

@*Hidden:Lines*@
<style>
    .e-spreadsheet-protection-dialog label,
    .e-spreadsheet-unprotect-dialog label,
    .e-unprotectworkbook-dlg label,
    .e-spreadsheet-name-manager-content label {
        font-weight: normal !important;
        margin-bottom: 0 !important;
    }

    .e-protectworkbook-dlg label {
        font-weight: normal !important;
    }
</style>
@*End:Hidden*@

@code {

    public byte[] DataSourceBytes { get; set; }
    public SfSpreadsheet _spreadsheetInstance { get; set; }

    protected override void OnInitialized()
    {
        @*Server:Block*@
#if !(WASM)
        //Sets the excel file path for initial loading.
        string filePath = "wwwroot/data/spreadsheet/freezepane.xlsx";
        DataSourceBytes = File.ReadAllBytes(filePath);
#endif
        @*End:Server*@

        @*WebAssembly:Block*@
#if (WASM)
    //Sets the excel file path for initial loading.
    string filePath = "";
     DataSourceBytes = Convert.FromBase64String(filePath);
#endif
        @*End:WebAssembly*@
    }

    @*Hidden:Lines*@
    @*WebAssembly:Block*@
#if (WASM)
    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender)
        {
            _spreadsheetInstance.CustomFonts = CustomFonts;
        }
    }

    public List<string> CustomFonts = new List<string>
    {
        "fonts/Arial.TTF",
        "fonts/Calibri.TTF",
        "fonts/Courier New.TTF",
        "fonts/Georgia.TTF",
        "fonts/Algerian.TTF",
        "fonts/Cambria.TTF",
        "fonts/Cambria Math.TTF",
        "fonts/Candara.TTF",
        "fonts/Impact.TTF",
        "fonts/Segoe Print.TTF",
        "fonts/Segoe UI.TTF",
        "fonts/Segoe Script.TTF",
        "fonts/Symbol.TTF",
        "fonts/Times New Roman.TTF",
        "fonts/Verdana.TTF",
        "fonts/Wingdings.TTF"
    };
#endif
    @*End:WebAssembly*@
    @*End:Hidden*@
}

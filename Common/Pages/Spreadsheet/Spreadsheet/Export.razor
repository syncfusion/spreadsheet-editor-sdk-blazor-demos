@page "/spreadsheet/export"

@using Syncfusion.Blazor.Buttons
@using Syncfusion.Blazor.Navigations
@using Syncfusion.Blazor.Spreadsheet
@using Syncfusion.Blazor.Ribbon
@using System;
@using System.IO;

@*Hidden:Lines*@
@inherits SampleBaseComponent;
@inject NavigationManager NavigationManager
@*End:Hidden*@


<ActionDescription>
    <p>This sample demonstrates the save functionality of the Blazor Spreadsheet using a car sales dataset. It highlights how structured data can be efficiently saved in multiple formats while preserving formatting, formulas, and layout for further analysis and sharing.</p>

    <p>The Blazor Spreadsheet supports saving data in multiple formats, ensuring compatibility and seamless integration across different applications. To enable saving, set the <a href="https://help.syncfusion.com/cr/blazor/Syncfusion.Blazor.Spreadsheet.SfSpreadsheet.html#Syncfusion_Blazor_Spreadsheet_SfSpreadsheet_AllowSave" target="_blank" rel="noopener noreferrer" aria-label="Navigate to the AllowSave property documentation">AllowSave</a> property to <strong>true</strong>.</p>

    <p><strong>Supported save formats:</strong></p>
    <ul>
        <li><strong>XLSX</strong> - Saves the spreadsheet with all applied formatting, formulas, and data in the modern <strong>Excel 2007+</strong> format for further editing in Excel.</li>
        <li><strong>XLS</strong> - Saves the file in the older <strong>Excel 97-2003</strong> format for compatibility with legacy systems and applications.</li>
        <li><strong>CSV</strong> - Saves raw data in a lightweight, plain-text format for easy integration with other tools and systems.</li>
        <li><strong>PDF</strong> - Converts the spreadsheet content into a printable and shareable document while retaining layout and styles.</li>
    </ul>

    <p>You can save the spreadsheet programmatically using the <a target="_blank" href="https://help.syncfusion.com/cr/blazor/Syncfusion.Blazor.Spreadsheet.SfSpreadsheet.html#Syncfusion_Blazor_Spreadsheet_SfSpreadsheet_SaveAsync_Syncfusion_Blazor_Spreadsheet_SaveOptions_" aria-label="Navigate to the Blazor Spreadsheet SaveAsync documentation">SaveAsync</a> method to save in different formats, or use the <a target="_blank" href="https://help.syncfusion.com/cr/blazor/Syncfusion.Blazor.Spreadsheet.SfSpreadsheet.html#Syncfusion_Blazor_Spreadsheet_SfSpreadsheet_SaveAsStreamAsync" aria-label="Navigate to the Blazor Spreadsheet SaveAsStreamAsync documentation">SaveAsStreamAsync</a> method to obtain the file as a memory stream for custom handling.</p>

    <p>In this demo, you can apply formatting and organize the car sales dataset, then save it using the available options in the ribbon toolbar.</p>

    <p>For more detailed information about saving, refer to the <a href="https://help.syncfusion.com/document-processing/excel/spreadsheet/blazor/open-and-save#save" target="_blank" rel="noopener noreferrer" aria-label="Navigate to the Blazor Spreadsheet save documentation">save documentation</a>.</p>

    <p>Looking for the full Blazor Spreadsheet Editor component overview, features, pricing, and documentation? Visit the <a rel="noopener" target='_blank' href='https://www.syncfusion.com/spreadsheet-editor-sdk/blazor-spreadsheet-editor' aria-label="Navigate to the Blazor Spreadsheet Editor FT page">Blazor Spreadsheet Editor component</a> page.</p>
</ActionDescription>


<div class="col-lg-12 control-section">
    <div class="content-wrapper">
        <div class="row">
            <div>
                <SfSpreadsheet DataSource="DataSourceBytes" @ref=_spreadsheetInstance>
                    <SpreadsheetRibbon RibbonTabItems="@HideAllTabs()" CustomRibbonTabs="@GetCustomTabs()">
                    </SpreadsheetRibbon>
                </SfSpreadsheet>
            </div>
        </div>
    </div>
</div>

@*Hidden:Lines*@
<style>
    .e-spreadsheet-protection-dialog label,
    .e-spreadsheet-unprotect-dialog label,
    .e-unprotectworkbook-dlg label,
    .e-spreadsheet-name-manager-content label {
        font-weight: normal !important;
        margin-bottom: 0 !important;
    }

    .e-protectworkbook-dlg label {
        font-weight: normal !important;
    }
    /* Hide File menu */
    .e-spreadsheet .e-ribbon-file-menu {
        display: none;
    }
</style>
@*End:Hidden*@

@code {
    public byte[] DataSourceBytes { get; set; }
    public SfSpreadsheet _spreadsheetInstance { get; set; }

    protected override void OnInitialized()
    {
        @*Server:Block*@
#if !(WASM)
        //Sets the excel file path for initial loading.
        string filePath = "wwwroot/data/spreadsheet/export.xlsx";
        DataSourceBytes = File.ReadAllBytes(filePath);
#endif
        @*End:Server*@

        @*WebAssembly:Block*@
#if (WASM)
    //Sets the excel file path for initial loading.
    string filePath = "";
    DataSourceBytes = Convert.FromBase64String(filePath);
#endif
        @*End:WebAssembly*@
    }

    @*Hidden:Lines*@
    @*WebAssembly:Block*@
#if (WASM)
    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender)
        {
            _spreadsheetInstance.CustomFonts = CustomFonts;
        }
    }

    public List<string> CustomFonts = new List<string>
    {
        "fonts/Arial.TTF",
        "fonts/Calibri.TTF",
        "fonts/Courier New.TTF",
        "fonts/Georgia.TTF",
        "fonts/Algerian.TTF",
        "fonts/Cambria.TTF",
        "fonts/Cambria Math.TTF",
        "fonts/Candara.TTF",
        "fonts/Impact.TTF",
        "fonts/Segoe Print.TTF",
        "fonts/Segoe UI.TTF",
        "fonts/Segoe Script.TTF",
        "fonts/Symbol.TTF",
        "fonts/Times New Roman.TTF",
        "fonts/Verdana.TTF",
        "fonts/Wingdings.TTF"
    };
#endif
    @*End:WebAssembly*@
    @*End:Hidden*@

    private List<SpreadsheetRibbonTab> HideAllTabs()
    {
        return new List<SpreadsheetRibbonTab>
        {
            new SpreadsheetRibbonTab { TabId = "homeTab", IsVisible = false },
            new SpreadsheetRibbonTab { TabId = "insertTab", IsVisible = false },
            new SpreadsheetRibbonTab { TabId = "formulasTab", IsVisible = false },
            new SpreadsheetRibbonTab { TabId = "dataTab", IsVisible = false },
            new SpreadsheetRibbonTab { TabId = "reviewTab", IsVisible = false },
            new SpreadsheetRibbonTab { TabId = "viewTab", IsVisible = false }
        };
    }

    private List<SpreadsheetCustomRibbonTab> GetCustomTabs()
    {
        return new List<SpreadsheetCustomRibbonTab>
        {
            new SpreadsheetCustomRibbonTab
            {
                Index = 0,
                Template = CreateSaveTab()
            }
        };
    }

    private RenderFragment CreateSaveTab()
    {
        return @<RibbonTab ID="saveTab" HeaderText="Save As">
                <RibbonGroups>
                    <RibbonGroup ID="saveGroup" HeaderText="Save Options"
                                 Orientation="Syncfusion.Blazor.Ribbon.Orientation.Row">
                        <RibbonCollections>
                            <RibbonCollection>
                                <RibbonItems>

                                    <!-- XLSX -->
                                    <RibbonItem Type="RibbonItemType.Button">
                                        <RibbonButtonSettings Content="XLSX"
                                                              IconCss="e-icons e-export-excel"
                                                              @onclick="SaveXlsx">
                                        </RibbonButtonSettings>
                                    </RibbonItem>

                                    <!-- XLS -->
                                    <RibbonItem Type="RibbonItemType.Button">
                                        <RibbonButtonSettings Content="XLS"
                                                              IconCss="e-icons e-export-xls"
                                                              @onclick="SaveXls">
                                        </RibbonButtonSettings>
                                    </RibbonItem>

                                    <!-- CSV -->
                                    <RibbonItem Type="RibbonItemType.Button">
                                        <RibbonButtonSettings Content="CSV"
                                                              IconCss="e-icons e-export-csv"
                                                              @onclick="SaveCsv">
                                        </RibbonButtonSettings>
                                    </RibbonItem>

                                    <!-- PDF -->
                                    <RibbonItem Type="RibbonItemType.Button">
                                        <RibbonButtonSettings Content="PDF"
                                                              IconCss="e-icons e-export-pdf"
                                                              @onclick="SavePdf">
                                        </RibbonButtonSettings>
                                    </RibbonItem>

                                </RibbonItems>
                            </RibbonCollection>
                        </RibbonCollections>
                    </RibbonGroup>
                </RibbonGroups>
        </RibbonTab>;
    }

    private async Task SaveXlsx()
    {
        await _spreadsheetInstance.SaveAsync( new SaveOptions
        {
            FileName = "Report",
            SaveType = SaveType.Xlsx
        });
    }

    private async Task SaveXls()
    {
        await _spreadsheetInstance.SaveAsync(new SaveOptions
        {
            FileName = "Report",
            SaveType = SaveType.Xls
        });
    }

    private async Task SaveCsv()
    {
        await _spreadsheetInstance.SaveAsync(new SaveOptions
        {
            FileName = "Report",
            SaveType = SaveType.Csv
        });
    }

    private async Task SavePdf()
    {
        await _spreadsheetInstance.SaveAsync(new SaveOptions
        {
            FileName = "Report",
            SaveType = SaveType.Pdf
        });
    }
}



@page "/spreadsheet/chart"

@using Syncfusion.Blazor.Spreadsheet
@using System;
@using System.IO;

@*Hidden:Lines*@
@inherits SampleBaseComponent;
@inject NavigationManager NavigationManager
@*End:Hidden*@


<SampleDescription>
    <p>This sample demonstrates charts in the Blazor Spreadsheet using GDP data. Compare values for different countries across multiple years.</p>
</SampleDescription>

<ActionDescription>
    <p>This sample demonstrates charts in the Blazor Spreadsheet by comparing the GDP of different countries across years. Use the chart view to review the data comparison visually. To enable charts, set the <a href="https://help.syncfusion.com/cr/blazor/Syncfusion.Blazor.Spreadsheet.SfSpreadsheet.html#Syncfusion_Blazor_Spreadsheet_SfSpreadsheet_AllowChart" target="_blank" rel="noopener noreferrer" aria-label="Navigate to the AllowChart property documentation">AllowChart</a> property to <strong>true</strong>. This allows users to add and manage charts alongside worksheet data.</p>

    <p><strong>Key Features</strong></p>
    <ul>
        <li><strong>Insert charts</strong> - Visualize data trends, comparisons, and relationships in worksheets.</li>
        <li><strong>Resize charts</strong> - Adjust chart height and width to fit the worksheet layout.</li>
        <li><strong>Reposition charts</strong> - Organize worksheet content using <strong>drag-and-drop</strong>.</li>
        <li><strong>Chart customization</strong> - Apply themes and styles, and modify titles, legends, axes, and data series.</li>
        <li><strong>Chart import and export</strong> - Preserve chart data, formatting, theme, axis, title, and chart type in Excel files.</li>
    </ul>
    <p>
        Insert charts through the ribbon or use <a target="_blank" href="https://help.syncfusion.com/cr/blazor/Syncfusion.Blazor.Spreadsheet.SfSpreadsheet.html#Syncfusion_Blazor_Spreadsheet_SfSpreadsheet_InsertChartAsync_System_" aria-label="Navigate to the Blazor Spreadsheet InsertChartAsync documentation">InsertChartAsync</a> and <a target="_blank" href="https://help.syncfusion.com/cr/blazor/Syncfusion.Blazor.Spreadsheet.SfSpreadsheet.html#Syncfusion_Blazor_Spreadsheet_SfSpreadsheet_DeleteChartAsync_System_String_" aria-label="Navigate to the Blazor Spreadsheet DeleteChartAsync documentation">DeleteChartAsync</a> for programmatic chart creation and removal.
    </p>
    <p>Learn how to visualize GDP data and manage charts alongside worksheet data.</p>

    <p><strong>Documentation Links</strong></p>
    <ul>
        <li><a href="https://help.syncfusion.com/document-processing/excel/spreadsheet/blazor/illustrations" target="_blank" rel="noopener noreferrer" aria-label="Navigate to the Blazor Spreadsheet Charts documentation">Charts</a></li>
        <li><a href="https://help.syncfusion.com/cr/blazor/Syncfusion.Blazor.Spreadsheet.SfSpreadsheet.html#Syncfusion_Blazor_Spreadsheet_SfSpreadsheet_AllowChart" target="_blank" rel="noopener noreferrer" aria-label="Navigate to the AllowChart property documentation">API Reference</a></li>
    </ul>

    <p><strong>More Resources</strong></p>
    <ul>
        <li><a href="https://github.com/SyncfusionExamples/blazor-spreadsheet-examples" target="_blank" rel="noopener noreferrer" aria-label="View the sample in GitHub">View Sample in GitHub</a></li>
    </ul>
    <p>Looking for the full Blazor Spreadsheet Editor component overview, features, pricing, and documentation? Visit the <a rel="noopener" target='_blank' href='https://www.syncfusion.com/spreadsheet-editor-sdk/blazor-spreadsheet-editor' aria-label="Navigate to the Blazor Spreadsheet Editor FT page">Blazor Spreadsheet Editor component</a> page.</p>
</ActionDescription>

<div class="col-lg-12 control-section">
    <div class="content-wrapper">
        <div class="row">
            <div>
                <SfSpreadsheet DataSource="DataSourceBytes" @ref=_spreadsheetInstance>
                    <SpreadsheetRibbon></SpreadsheetRibbon>
                </SfSpreadsheet>
            </div>

        </div>
    </div>
</div>

@*Hidden:Lines*@
<style>
    .e-spreadsheet-protection-dialog label,
    .e-spreadsheet-unprotect-dialog label,
    .e-unprotectworkbook-dlg label,
    .e-spreadsheet-name-manager-content label {
        font-weight: normal !important;
        margin-bottom: 0 !important;
    }

    .e-protectworkbook-dlg label {
        font-weight: normal !important;
    }
</style>
@*End:Hidden*@

@code {

    public byte[] DataSourceBytes { get; set; }
    public SfSpreadsheet _spreadsheetInstance { get; set; }

    protected override void OnInitialized()
    {
        @*Server:Block*@
#if !(WASM)
        //Sets the excel file path for initial loading.
        string filePath = "wwwroot/data/spreadsheet/chart.xlsx";
        DataSourceBytes = File.ReadAllBytes(filePath);
#endif
        @*End:Server*@

        @*WebAssembly:Block*@
#if (WASM)
    //Sets the excel file path for initial loading.
    string filePath = "";
    DataSourceBytes = Convert.FromBase64String(filePath);
#endif
        @*End:WebAssembly*@
    }

    @*Hidden:Lines*@
    @*WebAssembly:Block*@
#if (WASM)
    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender)
        {
            _spreadsheetInstance.CustomFonts = CustomFonts;
        }
    }

    public List<string> CustomFonts = new List<string>
    {
        "fonts/Arial.TTF",
        "fonts/Calibri.TTF",
        "fonts/Courier New.TTF",
        "fonts/Georgia.TTF",
        "fonts/Algerian.TTF",
        "fonts/Cambria.TTF",
        "fonts/Cambria Math.TTF",
        "fonts/Candara.TTF",
        "fonts/Impact.TTF",
        "fonts/Segoe Print.TTF",
        "fonts/Segoe UI.TTF",
        "fonts/Segoe Script.TTF",
        "fonts/Symbol.TTF",
        "fonts/Times New Roman.TTF",
        "fonts/Verdana.TTF",
        "fonts/Wingdings.TTF"
    };
#endif
    @*End:WebAssembly*@
    @*End:Hidden*@
}

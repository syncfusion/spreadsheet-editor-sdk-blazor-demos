@page "/spreadsheet/formula"

@using Syncfusion.Blazor.Spreadsheet
@using System;
@using System.IO;

@*Hidden:Lines*@
@inherits SampleBaseComponent;
@inject NavigationManager NavigationManager
@*End:Hidden*@

<SampleDescription>
    <p>This sample demonstrates formula calculations and data analysis using a stock analysis workbook. Explore named ranges, recalculation, and formula categories.</p>
</SampleDescription>

<ActionDescription>
    <p>This sample demonstrates formula calculations and data analysis in the Blazor Spreadsheet using a stock analysis workbook. Review price changes, percentage fluctuations, trends, named ranges, automatic recalculation, and formula categories.</p>

    <p><strong>Key Features</strong></p>
    <ul>
        <li><strong>400+ formulas</strong> - Use mathematical, statistical, financial, logical, and text functions for spreadsheet calculations.</li>
        <li><strong>Named ranges</strong> - Simplify formula references and improve formula readability.</li>
        <li><strong>Automatic recalculation</strong> - Update dependent results when input values change.</li>
        <li><strong>Stock analysis</strong> - Examine price changes, percentage fluctuations, and trend calculations in the sample workbook.</li>
    </ul>

    <p>Learn how to use formulas and functions for dynamic spreadsheet calculations and data analysis.</p>

    <p><strong>Documentation Links</strong></p>
    <ul>
        <li><a target="_blank" href="https://help.syncfusion.com/document-processing/excel/spreadsheet/blazor/formulas" aria-label="Navigate to the Blazor Spreadsheet formulas documentation">Formulas</a></li>
    </ul>

    <p><strong>More Resources</strong></p>
    <ul>
        <li><a href="https://github.com/SyncfusionExamples/blazor-spreadsheet-examples" target="_blank" rel="noopener noreferrer" aria-label="View the sample in GitHub">View Sample in GitHub</a></li>
    </ul>
    <p>Looking for the full Blazor Spreadsheet Editor component overview, features, pricing, and documentation? Visit the <a rel="noopener" target='_blank' href='https://www.syncfusion.com/spreadsheet-editor-sdk/blazor-spreadsheet-editor' aria-label="Navigate to the Blazor Spreadsheet Editor FT page">Blazor Spreadsheet Editor component</a> page.</p>
</ActionDescription>

<div class="col-lg-12 control-section">
    <div class="content-wrapper">
        <div class="row">

            <div>
                <SfSpreadsheet DataSource="DataSourceBytes">
                </SfSpreadsheet>
            </div>

        </div>
    </div>
</div>

@*Hidden:Lines*@
<style>
    .e-spreadsheet-protection-dialog label,
    .e-spreadsheet-unprotect-dialog label,
    .e-unprotectworkbook-dlg label,
    .e-spreadsheet-name-manager-content label {
        font-weight: normal !important;
        margin-bottom: 0 !important;
    }

    .e-protectworkbook-dlg label {
        font-weight: normal !important;
    }
</style>
@*End:Hidden*@

@code {

   public byte[] DataSourceBytes { get; set; }

    protected override void OnInitialized()
    {
        @*Server:Block*@
#if !(WASM)
        //Sets the excel file path for initial loading.
        string filePath = "wwwroot/data/spreadsheet/formula.xlsx";
        DataSourceBytes = File.ReadAllBytes(filePath);
#endif
        @*End:Server*@

        @*WebAssembly:Block*@
#if (WASM)
    //Sets the excel file path for initial loading.
    string filePath = "";
    DataSourceBytes = Convert.FromBase64String(filePath);
#endif
        @*End:WebAssembly*@
    }
}

